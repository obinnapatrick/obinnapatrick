# UK Strategic Supplier Dependency Atlas - required credentials
# Copy to .env (never committed) or export in your shell. Names only; never
# commit values. See docs/SECRETS_AND_ACCESS.md.

# Companies House public data API key (free registration:
# https://developer.company-information.service.gov.uk/).
# Used as HTTP Basic username with empty password.
COMPANIES_HOUSE_API_KEY=

