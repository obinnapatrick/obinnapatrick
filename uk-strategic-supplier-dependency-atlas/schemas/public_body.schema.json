{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/schemas/public_body.schema.json",
  "title": "PublicBody",
  "description": "",
  "type": "object",
  "required": [
    "body_id",
    "name",
    "contract_record_ids",
    "evidence",
    "fact_state"
  ],
  "properties": {
    "body_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "identifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs resolving to evidence-ledger records"
    },
    "fact_state": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "POSSIBLE",
        "UNRESOLVED",
        "CONFLICTING"
      ]
    }
  },
  "additionalProperties": true
}
