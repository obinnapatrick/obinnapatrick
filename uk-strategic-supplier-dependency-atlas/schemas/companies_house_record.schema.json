{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.local/schemas/companies_house_record.schema.json",
  "title": "CompaniesHouseRecord",
  "description": "",
  "type": "object",
  "required": [
    "company_number",
    "company_name",
    "retrieved_at",
    "raw_path",
    "evidence"
  ],
  "properties": {
    "company_number": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "company_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_of_creation": {
      "type": [
        "string",
        "null"
      ]
    },
    "registered_office": {
      "type": "object",
      "properties": {
        "locality": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Minimised: locality + postcode only"
    },
    "previous_names": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "ceased_on": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sic_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "psc_summary": {
      "type": "array",
      "description": "Org-level PSC entries; person-level only when required, minimised",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "natures_of_control": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notified_on": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "retrieved_at": {
      "type": "string"
    },
    "raw_path": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs resolving to evidence-ledger records"
    }
  },
  "additionalProperties": true
}
